<UserControl
    x:Class="WinUI2Demo.DemoShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winui="using:Microsoft.UI.Xaml.Controls">

    <Grid Background="{x:Null}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#CC1F1F1F" Padding="10,6">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <TextBlock Text="WinUI 2 + Frame/Page + 透明" Foreground="White"
                           FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="TransparencySwitch" Header="透明" IsOn="True"
                              Foreground="White" Toggled="Transparency_Toggled" />
                <ToggleSwitch x:Name="DesktopSwitch" Header="嵌入桌面" IsOn="False"
                              Foreground="White" Toggled="Desktop_Toggled" />
                <ToggleSwitch x:Name="FillSwitch" Header="铺满桌面" IsOn="False"
                              Foreground="White" Toggled="Fill_Toggled" />
                <Button Content="退出" Click="Quit_Click" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Frame x:Name="MainFrame" Grid.Row="1" Background="{x:Null}" />

        <Border Grid.Row="2" Background="#CC1F1F1F" Padding="10,6">
            <StackPanel Spacing="6">
                <!-- WinUI 2 控件：能渲染出来就说明 Microsoft.UI.Xaml 主题资源在岛内生效 -->
                <winui:InfoBar Message="WinUI 2 InfoBar 已渲染（Microsoft.UI.Xaml 主题资源生效）"
                               Severity="Success" IsOpen="True" IsClosable="False" />
                <TextBlock x:Name="StatusText" Foreground="#F0FFFFFF" FontSize="12"
                           TextWrapping="Wrap" Text="初始化中…" />
                <TextBlock x:Name="WorkspaceText" Foreground="#D0E8F0FF" FontSize="11"
                           TextWrapping="Wrap" Text="工作区: 初始化中…" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
