<UserControl
    x:Class="WinUI2Demo.DemoShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="{x:Null}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#CC1F1F1F" Padding="10,6">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <TextBlock Text="桌面文件视图 v1.0" Foreground="White"
                           FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="TransparencySwitch" Header="透明" IsOn="True"
                              Foreground="White" Toggled="Transparency_Toggled" />
                <Button Content="退出" Click="Quit_Click" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Frame x:Name="MainFrame" Grid.Row="1" Background="{x:Null}" />

        <Border Grid.Row="2" Background="#CC1F1F1F" Padding="10,6">
            <StackPanel Spacing="4">
                <TextBlock x:Name="StatusText" Foreground="#F0FFFFFF" FontSize="12"
                           TextWrapping="Wrap" Text="初始化中…" />
                <TextBlock x:Name="WorkspaceText" Foreground="#D0E8F0FF" FontSize="11"
                           TextWrapping="Wrap" Text="工作区: 初始化中…" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
