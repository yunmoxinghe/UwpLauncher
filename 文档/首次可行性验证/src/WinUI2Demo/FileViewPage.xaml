<Page
    x:Class="WinUI2Demo.FileViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI2Demo"
    Background="{x:Null}">

    <!-- 网格铺满整页：没有顶栏/状态条，桌面本身就是界面。右键菜单承载翻页/返回/刷新/退出 -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
            <MenuFlyout x:Key="DesktopMenu">
                <MenuFlyoutItem x:Name="PrevPageMenuItem" Text="上一页" Click="PrevPage_Click" />
                <MenuFlyoutItem x:Name="NextPageMenuItem" Text="下一页" Click="NextPage_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="UpMenuItem" Text="返回上一级" Click="Up_Click" />
                <MenuFlyoutItem Text="刷新" Click="Reload_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="退出" Click="Quit_Click" />
            </MenuFlyout>
        </Grid.Resources>

        <!-- 网格视图：固定槽位 + 双向虚拟化；滚动条与滚动都关闭，按可用区域分页 -->
        <GridView x:Name="FileList"
                  AutomationProperties.AutomationId="FileList"
                  AutomationProperties.Name="文件网格"
                  Background="{x:Null}"
                  Padding="0"
                  ItemContainerStyle="{StaticResource FileItemContainerStyle}"
                  ItemContainerTransitions="{x:Null}"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="FileList_ItemClick"
                  SelectionChanged="FileList_SelectionChanged"
                  DoubleTapped="FileList_DoubleTapped"
                  ContainerContentChanging="FileList_ContainerContentChanging"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ScrollViewer.VerticalScrollMode="Disabled"
                  SizeChanged="FileList_SizeChanged"
                  ItemsSource="{x:Bind VisibleItems}">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal"
                                   ItemWidth="{StaticResource ItemSlotWidth}"
                                   ItemHeight="{StaticResource ItemSlotHeight}" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:FileEntry">
                    <Border x:Name="ItemSurface"
                            Width="{StaticResource ItemContentWidth}"
                            Height="{StaticResource ItemContentHeight}"
                            Padding="{StaticResource ItemPadding}"
                            CornerRadius="{StaticResource ItemCornerRadius}"
                            Background="{StaticResource ItemIdleBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind Name}"
                            PointerEntered="Item_PointerEntered"
                            PointerExited="Item_PointerExited"
                            PointerPressed="Item_PointerPressed"
                            PointerReleased="Item_PointerReleased"
                            PointerCanceled="Item_PointerReleased"
                            PointerCaptureLost="Item_PointerReleased">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 两段式图标：类型字形立即可见，真图标/缩略图异步覆盖；与文字一样居中 -->
                            <Grid Grid.Row="0"
                                  Width="{StaticResource ItemIconBox}"
                                  Height="{StaticResource ItemIconBox}"
                                  HorizontalAlignment="Center">
                                <FontIcon Glyph="{x:Bind Glyph}" FontFamily="Segoe MDL2 Assets"
                                          FontSize="{StaticResource ItemIconGlyphSize}"
                                          Foreground="{StaticResource IconGlyphBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                       Width="{StaticResource ItemIconBox}"
                                       Height="{StaticResource ItemIconBox}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       x:Phase="1" />
                            </Grid>

                            <TextBlock Grid.Row="1" Text="{x:Bind Name}"
                                       Style="{StaticResource ItemNameTextStyle}"
                                       x:Phase="0" />

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="{x:Bind TypeText}"
                                           Style="{StaticResource ItemMetaTextStyle}"
                                           x:Phase="2" />
                                <TextBlock Text="·" Style="{StaticResource ItemMetaTextStyle}" />
                                <TextBlock Text="{x:Bind SizeText}"
                                           Style="{StaticResource ItemMetaTextStyle}"
                                           x:Phase="2" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
