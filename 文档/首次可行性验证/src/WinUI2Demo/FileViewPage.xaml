<Page
    x:Class="WinUI2Demo.FileViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI2Demo"
    Background="{x:Null}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#CC1F1F1F" Padding="10,4">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="FILE VIEW（Win32 枚举 · 虚拟化 ListView）" Foreground="White"
                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBox x:Name="PathBox" Width="380" FontSize="12" VerticalAlignment="Center"
                         AutomationProperties.Name="目录路径" />
                <Button x:Name="ReloadButton" Content="重新枚举" Click="Reload_Click"
                        VerticalAlignment="Center" />
                <Button x:Name="BackButton" Content="← 返回" Click="Back_Click"
                        VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <ListView x:Name="FileList" Grid.Row="1"
                  AutomationProperties.AutomationId="FileList"
                  AutomationProperties.Name="文件列表"
                  Background="{x:Null}"
                  Foreground="#FFE6EEF9"
                  ItemContainerTransitions="{x:Null}"
                  SelectionMode="Single"
                  IsItemClickEnabled="False"
                  ContainerContentChanging="FileList_ContainerContentChanging"
                  ItemsSource="{x:Bind Items}">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:FileEntry">
                    <Grid Height="30" Padding="6,0" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="96" />
                        </Grid.ColumnDefinitions>

                        <!-- 两段式图标：类型字形立即可见，真图标/缩略图异步覆盖 -->
                        <Grid Grid.Column="0" Width="24" Height="24" VerticalAlignment="Center">
                            <FontIcon Glyph="{x:Bind Glyph}" FontFamily="Segoe MDL2 Assets"
                                      FontSize="15" Foreground="#FFBFD8FF"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Width="24" Height="24"
                                   Stretch="Uniform" x:Phase="1" />
                        </Grid>

                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" Foreground="#FFE6EEF9"
                                   FontSize="13" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" x:Phase="0" />
                        <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" Foreground="#FFB9C6D6"
                                   FontSize="12" VerticalAlignment="Center" x:Phase="1" />
                        <TextBlock Grid.Column="3" Text="{x:Bind DateText}" Foreground="#FFB9C6D6"
                                   FontSize="12" VerticalAlignment="Center" x:Phase="1" />
                        <TextBlock Grid.Column="4" Text="{x:Bind TypeText}" Foreground="#FF9FB0C4"
                                   FontSize="12" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" x:Phase="2" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border Grid.Row="2" Background="#CC1F1F1F" Padding="10,6">
            <StackPanel Spacing="4">
                <TextBlock x:Name="StatusText" Foreground="White" FontSize="12"
                           TextWrapping="Wrap" Text="准备中…" />
                <TextBlock x:Name="MetricsText" Foreground="#D0D8E4" FontSize="11"
                           TextWrapping="Wrap" Text="" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
