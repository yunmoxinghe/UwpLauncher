<Page
    x:Class="WinUI2Demo.FileViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI2Demo"
    Background="{x:Null}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#CC1F1F1F" Padding="10,4">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="文件视图（Win32 枚举 · 网格虚拟化）" Foreground="White"
                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBox x:Name="PathBox" Width="380" FontSize="12" VerticalAlignment="Center"
                         AutomationProperties.Name="目录路径" />
                <Button x:Name="ReloadButton" Content="重新枚举" Click="Reload_Click"
                        VerticalAlignment="Center" />
                <Button x:Name="BackButton" Content="← 返回" Click="Back_Click"
                        VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 网格视图：ItemsWrapGrid 固定 176x104，双向虚拟化；模板字段与之前列表一致（图标 + 名称 + 类型/大小） -->
        <GridView x:Name="FileList" Grid.Row="1"
                  AutomationProperties.AutomationId="FileList"
                  AutomationProperties.Name="文件网格"
                  Background="{x:Null}"
                  Foreground="#FFE6EEF9"
                  ItemContainerTransitions="{x:Null}"
                  SelectionMode="None"
                  IsItemClickEnabled="False"
                  ContainerContentChanging="FileList_ContainerContentChanging"
                  ItemsSource="{x:Bind Items}">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="176" ItemHeight="104" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:FileEntry">
                    <Grid Width="168" Height="96" Padding="8,6" Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 两段式图标：类型字形立即可见，真图标/缩略图异步覆盖 -->
                        <Grid Grid.Row="0" Width="36" Height="36" HorizontalAlignment="Left">
                            <FontIcon Glyph="{x:Bind Glyph}" FontFamily="Segoe MDL2 Assets"
                                      FontSize="20" Foreground="#FFBFD8FF"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Width="32" Height="32"
                                   Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   x:Phase="1" />
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{x:Bind Name}" Foreground="#FFE6EEF9"
                                   FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                   MaxLines="2" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Top" x:Phase="0" />

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind TypeText}" Foreground="#FF9FB0C4"
                                       FontSize="11" TextTrimming="CharacterEllipsis" x:Phase="2" />
                            <TextBlock Text="{x:Bind SizeText}" Foreground="#FFB9C6D6"
                                       FontSize="11" x:Phase="2" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <Border Grid.Row="2" Background="#CC1F1F1F" Padding="10,6">
            <StackPanel Spacing="4">
                <TextBlock x:Name="StatusText" Foreground="White" FontSize="12"
                           TextWrapping="Wrap" Text="准备中…" />
                <TextBlock x:Name="MetricsText" Foreground="#D0D8E4" FontSize="11"
                           TextWrapping="Wrap" Text="" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
