<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 颜色 ===== -->
    <!-- 对齐 files-community/Files 的容器状态：选中态是低透明度强调色叠层、无描边
         （上游 GridLayoutPage.xaml 756-823：SelectedBorderBrush="Transparent"，
         状态底色取 WinUI 默认 GridViewItem 主题资源） -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFE6EEF9" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF9FB0C4" />
    <SolidColorBrush x:Key="IconGlyphBrush" Color="#FFBFD8FF" />

    <!-- 悬停/按下/选中：低透明度叠层，克制且可辨 -->
    <SolidColorBrush x:Key="ItemIdleBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="ItemPressedBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="ItemSelectedBrush" Color="#2E4CC2FF" />

    <!-- ===== 尺寸 / 间距 / 圆角 ===== -->
    <!-- 项宽取 Files GridView 密度表 "180"（Six）档：
         src/Files.App/Helpers/Layout/LayoutSizeKindHelper.cs:83-114
         （80/100/120/140/160/180/200/220/240/260/280/300 可选）
         圆角 4 = Files 使用的 GridViewItem 默认 GridViewItemCornerRadius（上游同文件 791、861 行） -->
    <x:Double x:Key="ItemSlotWidth">180</x:Double>
    <x:Double x:Key="ItemSlotHeight">104</x:Double>
    <x:Double x:Key="ItemContentWidth">172</x:Double>
    <x:Double x:Key="ItemContentHeight">96</x:Double>
    <x:Double x:Key="ItemIconBox">32</x:Double>
    <x:Double x:Key="ItemIconGlyphSize">20</x:Double>
    <x:Double x:Key="ItemNameFontSize">13</x:Double>
    <x:Double x:Key="ItemMetaFontSize">11</x:Double>
    <Thickness x:Key="ItemPadding">8,6</Thickness>
    <CornerRadius x:Key="ItemCornerRadius">4</CornerRadius>

    <!-- ===== 文字样式 ===== -->
    <!-- 名称两行省略、居中换行：对齐上游 GridLayoutPage.xaml 198-208
         （TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center"） -->
    <Style x:Key="ItemNameTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource ItemNameFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style x:Key="ItemMetaTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource ItemMetaFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 容器只负责铺满槽位；悬停/按下/选中由条目模板的自绘圆角层承担 -->
    <Style x:Key="FileItemContainerStyle" TargetType="GridViewItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewItem">
                    <Grid Background="Transparent">
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
