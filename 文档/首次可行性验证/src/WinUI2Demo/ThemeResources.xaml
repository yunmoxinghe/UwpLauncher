<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        取值来源（审计基线）：
        Files 上游 files-community/Files @ ee5ba5648541880c98a56436d65d1f9d108332b1（v4.3.3, 2026-11-08）
        颜色/字体数值来自 WinUI 3 的 ThemeResource（Files 只引用键名）：
        - microsoft/microsoft-ui-xaml winui3/release/1.7-stable
          src/controls/dev/CommonStyles/GridViewItem_themeresources.xaml
          src/controls/dev/CommonStyles/Common_themeresources_any.xaml
        完整逐键对照见 ../../FILES_STYLE_AUDIT.md
    -->

    <!-- ===== 文字 / 图标颜色 ===== -->
    <!-- TextFillColorPrimary / Secondary（Common_themeresources_any.xaml:5-6，Dark） -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5FFFFFF" />
    <!-- 自有扩展：Files 用真实图标位图，我们用字形占位，取次级文字色保持一致观感 -->
    <SolidColorBrush x:Key="IconGlyphBrush" Color="#C5FFFFFF" />

    <!-- ===== 条目状态：底色 / 描边 ===== -->
    <!-- 空闲 = SubtleFillColorTransparent（GridViewItem_themeresources.xaml:5） -->
    <SolidColorBrush x:Key="ItemIdleBrush" Color="#00FFFFFF" />
    <!-- 悬停/按下 = App.Theme.CardBackgroundFillColorTertiaryBrush（Files App.xaml:154 Dark = #12FFFFFF）
         使用处：GridLayoutPage.xaml:927（PointerOver）、:930（Pressed） -->
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="ItemPressedBrush" Color="#12FFFFFF" />
    <!-- 选中底 = CardBackgroundFillColorDefault（Common_themeresources_any.xaml:55 Dark = #0DFFFFFF）
         使用处：GridLayoutPage.xaml:932 -->
    <SolidColorBrush x:Key="ItemSelectedBrush" Color="#0DFFFFFF" />
    <!-- 选中描边 = GridViewItemSelectedBorderBrush → AccentFillColorDefaultBrush
         （GridViewItem_themeresources.xaml:27、:113）；2px 见 :25、:111 -->
    <SolidColorBrush x:Key="ItemSelectedBorderBrush" Color="{ThemeResource SystemAccentColor}" />
    <x:Double x:Key="ItemSelectedBorderThickness">2</x:Double>
    <SolidColorBrush x:Key="ItemIdleBorderBrush" Color="#00FFFFFF" />

    <!-- ===== 尺寸 / 间距 / 圆角 ===== -->
    <!-- 槽位宽取 Files GridView 密度表 Six 档 = 180
         （src/Files.App/Helpers/Layout/LayoutSizeKindHelper.cs:83-114） -->
    <x:Double x:Key="ItemSlotWidth">180</x:Double>
    <!-- 槽高为桌面嵌入形态自有：Files 项高 = 图标方格(180/…) + 60 名称区，属资源管理器窗口密度 -->
    <x:Double x:Key="ItemSlotHeight">104</x:Double>
    <x:Double x:Key="ItemContentWidth">180</x:Double>
    <x:Double x:Key="ItemContentHeight">104</x:Double>
    <!-- 图标：Files 主图标 96/128/256（LayoutSizeKindHelper.cs:47-50），
         叠加角标 32（GridLayoutPage.xaml:124-125）；桌面瓦片取 32 -->
    <x:Double x:Key="ItemIconBox">32</x:Double>
    <x:Double x:Key="ItemIconGlyphSize">20</x:Double>
    <!-- 名称字号 = ControlContentThemeFontSize 14（UWP generic.xaml:40 同名键）；
         Files 名称 TextBlock 未设字号，继承该值（GridLayoutPage.xaml:198-208） -->
    <x:Double x:Key="ItemNameFontSize">14</x:Double>
    <!-- WinUI Body 行高 20（两行 40） -->
    <x:Double x:Key="ItemNameLineHeight">20</x:Double>
    <!-- 副信息为自有扩展；取 Caption 档 12（Files TextBlockStyles.xaml:34 引用 CaptionTextBlockFontSize） -->
    <x:Double x:Key="ItemMetaFontSize">12</x:Double>
    <!-- 文字区内边距对齐 Files 文字区 Margin="4,0,4,8"（GridLayoutPage.xaml:164） -->
    <Thickness x:Key="ItemPadding">4,6,4,8</Thickness>
    <!-- 4px 为用户明确要求（Files 的 LocalRegularItemContainerStyle 为 8，见 GridLayoutPage.xaml:915） -->
    <CornerRadius x:Key="ItemCornerRadius">4</CornerRadius>

    <!-- ===== 文字样式 ===== -->
    <Style x:Key="ItemNameTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource ItemNameFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="{StaticResource ItemNameLineHeight}" />
        <Setter Property="LineStackingStrategy" Value="MaxHeight" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style x:Key="ItemMetaTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource ItemMetaFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 容器只负责铺满槽位；悬停/按下/选中由条目模板的自绘圆角层承担
         （WinUI 2 在嵌入桌面/非激活窗口下不跑 GridViewItem 的 VSM，必须自绘） -->
    <Style x:Key="FileItemContainerStyle" TargetType="GridViewItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewItem">
                    <Grid Background="Transparent">
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
