<Page
    x:Class="WinUI2Probe.PageA"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <SolidColorBrush x:Key="PageAOnlyBrush" Color="DodgerBlue" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="96" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF1E90FF">
            <TextBlock Text="PAGE A (DodgerBlue band)" Foreground="White" FontSize="15"
                       Margin="12,0,0,0" VerticalAlignment="Center" />
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBlock Text="TRANSPARENT REGION" Foreground="White" FontSize="13"
                           Margin="12" VerticalAlignment="Top" />
            </Grid>

            <Border Grid.Column="1" Background="#80FF0000">
                <TextBlock Text="50% RED" Foreground="White" FontSize="18"
                           Margin="12" VerticalAlignment="Top" />
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="StateBox" Grid.Column="0" Text="state" IsReadOnly="True"
                     FontSize="12" Margin="8" VerticalAlignment="Top" />

            <ScrollViewer x:Name="Scroller" Grid.Column="1" Margin="8"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="scroll item 0" FontSize="12" Height="22" />
                    <TextBlock Text="scroll item 1" FontSize="12" Height="22" />
                    <TextBlock Text="scroll item 2" FontSize="12" Height="22" />
                    <TextBlock Text="scroll item 3" FontSize="12" Height="22" />
                    <TextBlock Text="scroll item 4" FontSize="12" Height="22" />
                    <TextBlock Text="scroll item 5" FontSize="12" Height="22" />
                    <TextBlock Text="scroll item 6" FontSize="12" Height="22" />
                    <TextBlock Text="scroll item 7" FontSize="12" Height="22" />
                    <TextBlock Text="scroll item 8" FontSize="12" Height="22" />
                    <TextBlock Text="scroll item 9" FontSize="12" Height="22" />
                    <TextBlock Text="scroll item 10" FontSize="12" Height="22" />
                    <TextBlock Text="scroll item 11" FontSize="12" Height="22" />
                    <TextBlock Text="scroll item 12" FontSize="12" Height="22" />
                    <TextBlock Text="scroll item 13" FontSize="12" Height="22" />
                    <TextBlock Text="scroll item 14" FontSize="12" Height="22" />
                    <TextBlock Text="scroll item 15" FontSize="12" Height="22" />
                    <TextBlock Text="scroll item 16" FontSize="12" Height="22" />
                    <TextBlock Text="scroll item 17" FontSize="12" Height="22" />
                    <TextBlock Text="scroll item 18" FontSize="12" Height="22" />
                    <TextBlock Text="scroll item 19" FontSize="12" Height="22" />
                    <TextBlock Text="scroll item 20" FontSize="12" Height="22" />
                    <TextBlock Text="scroll item 21" FontSize="12" Height="22" />
                    <TextBlock Text="scroll item 22" FontSize="12" Height="22" />
                    <TextBlock Text="scroll item 23" FontSize="12" Height="22" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
